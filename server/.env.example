# ------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores.
# NUNCA comitees el `.env` real (ya está en .gitignore).
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Railway: Postgres -> pestaña "Variables" -> DATABASE_URL
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tarot

# En Railway el certificado no es de una CA pública -> pon "true".
# En local con Postgres sin TLS -> "false".
DATABASE_SSL=false

# Secreto para firmar los access tokens (JWT).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo 32 caracteres. Distinto por entorno.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad

# Vida del access token (formato de `ms`: 15m, 1h, 7d)
ACCESS_TOKEN_TTL=15m
# Vida del refresh token en días
REFRESH_TOKEN_TTL_DAYS=30

# Origen(es) permitidos del frontend, separados por coma
CORS_ORIGIN=http://localhost:3000

# Dominio de la cookie de refresh. Déjalo vacío en local.
# En producción, si api.tudominio.com y www.tudominio.com comparten dominio: .tudominio.com
COOKIE_DOMAIN=

# Rondas de bcrypt. 12 es un buen equilibrio coste/seguridad en 2026.
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------
# Videollamada
# ------------------------------------------------------------------
# Proveedor de vídeo:
#   jitsi (demo) → sala embebible en un iframe, sin cuenta ni claves.
#   teams        → usa el joinWebUrl; NO embebe (el frontend ofrece "abrir
#                  en Teams"). Requiere TEAMS_DEFAULT_JOIN_URL o Graph API.
VIDEO_PROVIDER=jitsi

# Host de Jitsi. El público sirve para demo.
JITSI_HOST=meet.jit.si

# Enlace de sala de Teams por defecto (joinWebUrl), solo si VIDEO_PROVIDER=teams.
# Consíguelo creando una reunión en Teams y copiando el enlace "Unirse".
TEAMS_DEFAULT_JOIN_URL=

# ------------------------------------------------------------------
# Recarga de saldo
# ------------------------------------------------------------------
# MODO DEMO: deja STRIPE_SECRET_KEY vacío. La recarga acredita saldo sin
# cobro real. Cuando quieras cobros de verdad, rellena las claves de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Máximo por recarga en modo demo, en céntimos (500 = 5,00 €).
DEMO_TOPUP_MAX_CENTS=50000
